# ==============================================================================
# Attendance Auditor - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and supply production values. NEVER commit '.env' to git!

# Application Environment (development | production | testing)
ENVIRONMENT=development

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Neon.tech Async PostgreSQL connection URL (TLS mandatory: sslmode=require)
DATABASE_URL=postgresql+asyncpg://neondb_owner:sample_secure_password_replace_me@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Cryptographic Secret (Minimum 32 characters, generated via `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=4f7b2c9e8d1a3f6b5c0e2a4d6f8b0c2e4a6f8b0c2e4a6f8b0c2e4a6f8b0c2e4a
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Allowed CORS Origins (JSON array of strings, restricted to Cloudflare Pages and local dev)
CORS_ORIGINS=["https://attendance-auditor.pages.dev", "http://localhost:5173", "http://127.0.0.1:5173"]

# Maximum File Upload Size in Bytes (10 MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760
